# node deps — restored by `npm ci`, never committed
node_modules/
.DS_Store
.scratch/
.verify/

# shared/ is TypeScript source; the .js and .d.ts beside it are BUILD OUTPUT
# (shared/tsconfig.json). `npm run build` in scripts/ regenerates them.
shared/*.js
shared/*.d.ts
# …except vendored libraries and their declarations: generated by
# scripts/sync-vendor.ts from a pin, not by tsc, and the server image needs them as
# committed bytes. sync-vendor.ts appends a line here for each new one.
!shared/pairwise.js
!shared/pairwise.d.ts

# the page is built from web/src/ by Vite into web/dist/. `web/app.js` was tsc's output
# before the bundler landed; a stale one on disk is served by the local harness in
# preference to nothing, so both names stay listed.
web/dist/
web/app.js
web/app.js.map
