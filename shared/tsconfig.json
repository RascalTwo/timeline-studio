{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowJs": false,
    "removeComments": false,
    "newLine": "lf",
    "noEmitOnError": true,
    "declaration": true
  },
  "include": [
    "*.ts"
  ]
}
